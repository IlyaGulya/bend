import Base

# Development surrogate only; the original scheduler remains the qualification gate.
# Width is regenerated by semantic_scheduler_perf_source.ts; protocol and workload stay fixed.
# BEGIN PERF WIDTH
# groups=1 arms=4
# END PERF WIDTH

def Perf.Words() -> Type:
  List<U32>

def Perf.Pair(-A: Type, -B: Type) -> Type:
  A & B

def Perf.Flagged() -> Type:
  Perf.Pair(U32, Bool)

type PerfValue<-A: Type> is Type:
  PerfValue{value: A}

type PerfPayload<-A: Type> is Type:
  PerfPayload{words: Array<U32>, value: A}

def Perf.array_sum(words: Array<U32>) -> U32:
  match words:
    case ALeaf{value}: value
    case ANode{left, right}: U32.add(Perf.array_sum(left), Perf.array_sum(right))

def Perf.shift(values: Perf.Words(), +bias: U32) -> Perf.Words():
  match values:
    case Nil{}: Nil{}
    case Con{value, rest}: Con{U32.add(value, bias), Perf.shift(rest, bias)}

def Perf.words_score(values: Perf.Words()) -> U32:
  match values:
    case Nil{}: 0
    case Con{value, rest}: U32.add(value, Perf.words_score(rest))

def Perf.pair_score(value: Perf.Flagged()) -> U32:
  (number, flag) = value
  U32.add(number, Bool.to_u32(flag))

def Perf.payload_pair(payload: PerfPayload<PerfValue<Perf.Flagged()>>, bias: U32) -> Perf.Flagged():
  match payload:
    case PerfPayload{words, PerfValue{value}}:
      (number, flag) = value
      (U32.add(U32.add(Perf.array_sum(words), number), bias), flag)

# BEGIN PERF REQUESTS
type PerfRequestGroup0 is Type:
  PerfRequest_0_0{left: U32, right: U32}
  PerfRequest_0_1{left: U32, right: U32}
  PerfRequest_0_2{values: Perf.Words(), bias: U32}
  PerfRequest_0_3{payload: PerfPayload<PerfValue<Perf.Flagged()>>, bias: U32}

type PerfRequest is Type:
  PerfRequestGroup_0{request: PerfRequestGroup0}

def Perf.result_group_0(request: PerfRequestGroup0) -> Type:
  match request:
    case PerfRequest_0_0{_, _}: U32
    case PerfRequest_0_1{_, _}: Bool
    case PerfRequest_0_2{_, _}: Perf.Words()
    case PerfRequest_0_3{_, _}: Perf.Flagged()

def Perf.result(request: PerfRequest) -> Type:
  match request:
    case PerfRequestGroup_0{inner}: Perf.result_group_0(inner)


# END PERF REQUESTS

# Exact generic scheduler schema, alpha-renamed from checker_core_steps_v1.bend.

type PerfProgress<-A: Type> is Type:
  PerfFinished{box: PerfValue<A>}
  PerfPending{request: PerfRequest, resume: (@box: PerfValue<Perf.result(request)> -> PerfProgress<A>)}
  PerfDirect{-R: Type, -request: PerfRequest, arguments: R, invoke: (@arguments: R -> PerfProgress<Perf.result(request)>), resume: (@box: PerfValue<Perf.result(request)> -> PerfProgress<A>)}
  PerfBound{-B: Type, inner: PerfProgress<B>, resume: (@box: PerfValue<B> -> PerfProgress<A>)}

type PerfStack<-A: Type, -R: Type> is Type:
  PerfStackDone{equation: {A == R : Type}}
  PerfStackMore{-B: Type, resume: (@box: PerfValue<A> -> PerfProgress<B>), rest: PerfStack<B, R>}

type PerfRun<-R: Type> is Type:
  PerfRunFinished{box: PerfValue<R>}
  PerfRunState{-A: Type, progress: PerfProgress<A>, stack: PerfStack<A, R>}

# BEGIN PERF DISPATCH
def Perf.step_group_0(request: PerfRequestGroup0) -> PerfProgress<Perf.result_group_0(request)>:
  match request:
    case PerfRequest_0_0{left, right}:
      PerfFinished{PerfValue{U32.add(U32.add(left, right), 0)}}
    case PerfRequest_0_1{left, right}:
      PerfFinished{PerfValue{U32.is_lt(U32.add(left, 1), right)}}
    case PerfRequest_0_2{values, bias}:
      PerfFinished{PerfValue{Perf.shift(values, U32.add(bias, 2))}}
    case PerfRequest_0_3{payload, bias}:
      PerfFinished{PerfValue{Perf.payload_pair(payload, U32.add(bias, 3))}}

def Perf.step_one(request: PerfRequest) -> PerfProgress<Perf.result(request)>:
  match request:
    case PerfRequestGroup_0{inner}: Perf.step_group_0(inner)
# END PERF DISPATCH


def Perf.cast(-A: Type, -R: Type, equation: {A == R : Type}, box: PerfValue<A>) -> PerfValue<R>:
  %equation : PerfValue<_>
  box

def Perf.unbox(-A: Type, box: PerfValue<A>) -> A:
  match box:
    case PerfValue{value}: value

def Perf.pop(-A: Type, -R: Type, stack: PerfStack<A, R>, box: PerfValue<A>) -> PerfRun<R>:
  match stack:
    case PerfStackDone{equation}: PerfRunFinished{Perf.cast(A, R, equation, box)}
    case PerfStackMore{B, resume, rest}: PerfRunState{B, resume(box), rest}

def Perf.advance(-A: Type, -R: Type, progress: PerfProgress<A>, stack: PerfStack<A, R>) -> PerfRun<R>:
  match progress:
    case PerfFinished{box}: Perf.pop(A, R, stack, box)
    case PerfPending{request, resume}:
      PerfRunState{Perf.result(request), Perf.step_one(request), PerfStackMore{A, resume, stack}}
    case PerfDirect{T, request, arguments, invoke, resume}:
      PerfRunState{Perf.result(request), invoke(arguments), PerfStackMore{A, resume, stack}}
    case PerfBound{B, inner, resume}:
      PerfRunState{B, inner, PerfStackMore{A, resume, stack}}

def Perf.chunk(-R: Type, fuel: Nat, run: PerfRun<R>) -> PerfRun<R>:
  match fuel run:
    case 0n state: state
    case 1n+rest PerfRunFinished{box}: PerfRunFinished{box}
    case 1n+rest PerfRunState{A, progress, stack}:
      Perf.chunk(R, rest, Perf.advance(A, R, progress, stack))

def Perf.step(-R: Type, run: PerfRun<R>) -> PerfRun<R>:
  Perf.chunk(R, 64n, run)

# Preserve the original zero/exact/over-quantum and heterogeneous-stack scenarios.
def Perf.increment(box: PerfValue<U32>) -> PerfProgress<U32>:
  match box:
    case PerfValue{value}:
      PerfFinished{PerfValue{U32.add(value, 1)}}

def Perf.wrap(count: Nat, progress: PerfProgress<U32>) -> PerfProgress<U32>:
  match count:
    case 0n: progress
    case 1n+rest: Perf.wrap(rest, PerfBound{U32, progress, Perf.increment})

def Perf.run(progress: PerfProgress<U32>) -> PerfRun<U32>:
  PerfRunState{U32, progress, PerfStackDone{{==}}}

def Perf.pure(count: Nat) -> PerfRun<U32>:
  Perf.run(Perf.wrap(count, PerfFinished{PerfValue{0}}))

def Perf.request() -> PerfRequest:
  PerfRequestGroup_0{PerfRequest_0_0{8, 9}}

def Perf.pending(count: Nat) -> PerfRun<U32>:
  Perf.run(Perf.wrap(count, PerfPending{Perf.request(), box => PerfFinished{box}}))

def Perf.direct(count: Nat) -> PerfRun<U32>:
  Perf.run(Perf.wrap(count, PerfDirect{U32, Perf.request(), 40,
    argument => PerfFinished{PerfValue{U32.add(argument, 1)}},
    box => PerfFinished{box}}))

def Perf.score(value: PerfRun<U32>) -> U32:
  match value:
    case PerfRunFinished{PerfValue{result}}: result
    case PerfRunState{_, _, _}: 4294967295

def Perf.heterogeneous() -> PerfRun<Bool>:
  PerfRunState{U32, PerfFinished{PerfValue{7}},
    PerfStackMore{Bool,
      box => PerfFinished{PerfValue{U32.is_eq(Perf.unbox(U32, box), 7)}},
      PerfStackDone{{==}}}}

def Perf.bool_score(value: PerfRun<Bool>) -> U32:
  match value:
    case PerfRunFinished{PerfValue{result}}: Bool.to_u32(result)
    case PerfRunState{_, _, _}: 2

def Perf.owned_direct() -> PerfRun<U32>:
  captured = {ANode{ALeaf{10}, ALeaf{11}} : Array<U32>}
  Perf.run(PerfDirect{PerfPayload<PerfValue<Perf.Flagged()>>, Perf.request(),
    PerfPayload{ANode{ALeaf{4}, ALeaf{5}}, PerfValue{(7, True{})}},
    arguments => PerfFinished{PerfValue{Perf.pair_score(Perf.payload_pair(arguments, 0))}},
    box => PerfFinished{PerfValue{U32.add(Perf.unbox(U32, box), Perf.array_sum(captured))}}})

# Every retained request arm is executed, not merely retained as dead type variety.
# BEGIN PERF WORKLOAD
def Perf.request_score_0_0() -> U32:
  Perf.score(Perf.step(U32, Perf.run(PerfPending{
    PerfRequestGroup_0{PerfRequest_0_0{8, 9}},
    box => PerfFinished{PerfValue{Perf.unbox(U32, box)}}})))

def Perf.request_score_0_1() -> U32:
  Perf.score(Perf.step(U32, Perf.run(PerfPending{
    PerfRequestGroup_0{PerfRequest_0_1{3, 5}},
    box => PerfFinished{PerfValue{Bool.to_u32(Perf.unbox(Bool, box))}}})))

def Perf.request_score_0_2() -> U32:
  Perf.score(Perf.step(U32, Perf.run(PerfPending{
    PerfRequestGroup_0{PerfRequest_0_2{[1, 2, 3], 2}},
    box => PerfFinished{PerfValue{Perf.words_score(Perf.unbox(Perf.Words(), box))}}})))

def Perf.request_score_0_3() -> U32:
  Perf.score(Perf.step(U32, Perf.run(PerfPending{
    PerfRequestGroup_0{PerfRequest_0_3{PerfPayload{ANode{ALeaf{4}, ALeaf{5}}, PerfValue{(7, True{})}}, 2}},
    box => PerfFinished{PerfValue{Perf.pair_score(Perf.unbox(Perf.Flagged(), box))}}})))

def Perf.print_requests() -> IO(Unit):
  +score_0_0 = Perf.request_score_0_0()
  +score_0_1 = Perf.request_score_0_1()
  +score_0_2 = Perf.request_score_0_2()
  +score_0_3 = Perf.request_score_0_3()
  checksum_0 = U32.add(0, score_0_0)
  checksum_1 = U32.add(checksum_0, score_0_1)
  checksum_2 = U32.add(checksum_1, score_0_2)
  checksum_3 = U32.add(checksum_2, score_0_3)
  do IO<Unit>:
    IO.print(U32.show(score_0_0))
    IO.print(U32.show(score_0_1))
    IO.print(U32.show(score_0_2))
    IO.print(U32.show(score_0_3))
    IO.print(U32.show(checksum_3))

# END PERF WORKLOAD

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 0n, Perf.pure(0n)))))
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 0n, PerfRunFinished{PerfValue{37}}))))
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 1n, Perf.pure(0n)))))
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 2n, Perf.pure(1n)))))
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 3n, Perf.pure(1n)))))
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 63n, Perf.pure(31n)))))
    IO.print(U32.show(Perf.score(Perf.step(U32, Perf.pure(32n)))))
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 1n, Perf.step(U32, Perf.pure(32n))))))
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 33n, Perf.chunk(U32, 32n, Perf.pure(32n))))))
    IO.print(U32.show(Perf.score(Perf.step(U32, Perf.pending(31n)))))
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 1n, Perf.step(U32, Perf.pending(31n))))))
    IO.print(U32.show(Perf.score(Perf.step(U32, Perf.direct(31n)))))
    IO.print(U32.show(Perf.score(Perf.chunk(U32, 1n, Perf.step(U32, Perf.direct(31n))))))
    IO.print(U32.show(Perf.bool_score(Perf.chunk(Bool, 1n, Perf.heterogeneous()))))
    IO.print(U32.show(Perf.bool_score(Perf.chunk(Bool, 2n, Perf.heterogeneous()))))
    IO.print(U32.show(Perf.score(Perf.step(U32, Perf.owned_direct()))))
    Perf.print_requests()

