import Base
import ../bend2/selfhost/loaded_module.bend as Loader
import ../bend2/selfhost/backend_ir.bend as BIR
import ../bend2/selfhost/c_backend_layout.bend as CLay
import ../bend2/selfhost/c_backend_physical.bend as Phys

# Phys borrowed Project smoke: the emitted expressions of project_borrowed for
# a plain Pair and a nested Seg(Pt,Pt,Fl), generated by the canonical physical
# module. The canonical source pass typechecks and factors it; the C consumer
# evaluates the expressions against the real runtime.

type ViewSmoke is Data:
  ViewSmoke{text: String}

def fld(+ty: BIR.Descriptor) -> BIR.DescriptorField:
  BIR.DescriptorField{None{}, BIR.Unrestricted{}, ty}

def arm(+key: String, +fields: List<&2, BIR.DescriptorField>) -> BIR.DescriptorArm:
  BIR.DescriptorArm{key, fields}

def ref(+key: String, +args: List<&2, BIR.Descriptor>) -> BIR.Descriptor:
  BIR.DescriptorRef{key, args}

def fam(+key: String, +native: Maybe<&2, String>, +arms: List<&2, BIR.DescriptorArm>) -> BIR.Family:
  BIR.Family{key, key, native, 0n, 0n, arms}

def array_fam() -> BIR.Family:
  BIR.Family{"Array", "Array", Some{"Array"}, 0n, 1n, Nil{}}

def families() -> List<&2, BIR.Family>:
  [
    fam("U32", Some{"U32"}, Nil{}),
    fam("Pt", None{}, [arm("Pt", [fld(ref("U32", Nil{})), fld(ref("U32", Nil{}))])]),
    fam("Fl", None{}, [arm("Fl", [fld(ref("U32", Nil{}))])]),
    fam("Pair", None{}, [arm("Pair", [fld(ref("U32", Nil{})), fld(ref("U32", Nil{}))])]),
    fam("Seg", None{}, [arm("Seg", [fld(ref("Pt", Nil{})), fld(ref("Pt", Nil{})), fld(ref("Fl", Nil{}))])]),
    fam("Unit", None{}, [arm("Unit", Nil{})]),
    fam("BoxP", None{}, [arm("BoxP", [fld(ref("AB", Nil{})), fld(ref("Unit", Nil{}))])]),
    array_fam(),
    fam("Arr", None{}, [arm("Arr", [fld(ref("Array", [ref("U32", Nil{})]))])])
  ]

def row(+id: U32, +key: String, +arity: Nat) -> BIR.ConstructorLayout:
  BIR.ConstructorLayout{id, key, None{}, List.replicate(Maybe<&2, String>, arity, None{})}

def constructors() -> List<&2, BIR.ConstructorLayout>:
  [row(0, "Pair", 2n), row(1, "Pt", 2n), row(2, "Fl", 1n), row(3, "Seg", 3n), row(4, "BoxP", 2n), row(5, "Unit", 0n), row(6, "Arr", 1n)]

def program() -> BIR.Program:
  BIR.Program{Nil{}, Nil{}, constructors(), families(), Nil{}, BIR.Executable{BIR.DescriptorRef{"U32", Nil{}}}}

def world() -> Phys.World:
  ctx = CLay.context(program())
  Phys.world(ctx, constructors(), families(), [Phys.CidSym{0, "Pair"}, Phys.CidSym{1, "Pt"}, Phys.CidSym{2, "Fl"}, Phys.CidSym{3, "Seg"}, Phys.CidSym{4, "BoxP"}, Phys.CidSym{5, "Unit"}, Phys.CidSym{6, "Arr"}])

def show_part(+part: Phys.Part) -> String:
  match part:
    case Phys.PartOk{text}: String.append(text, "\n")
    case Phys.PartFail{message}: String.append("FAIL ", String.append(message, "\n"))

def pair_parts(+w: Phys.World) -> String:
  a = show_part(Phys.path_read("pair_value", [Phys.PathField{0, 0}], w))
  b = show_part(Phys.path_copy("pair_value", [Phys.PathField{0, 1}], w))
  String.append(a, b)

def seg_parts(+w: Phys.World) -> String:
  a = show_part(Phys.path_hastag("seg_value", [Phys.PathField{3, 0}], 1, w))
  b = show_part(Phys.path_consume("seg_value", [Phys.PathField{3, 0}, Phys.PathField{1, 0}], w))
  c = show_part(Phys.path_consume("seg_value", [Phys.PathField{3, 2}], w))
  String.append(a, String.append(b, c))

def box_parts(+w: Phys.World) -> String:
  a = show_part(Phys.path_consume("box_value", [Phys.PathField{4, 0}], w))
  b = show_part(Phys.path_copy("box_value", [Phys.PathField{4, 1}], w))
  String.append(a, b)

def array_parts(+w: Phys.World) -> String:
  a = show_part(Phys.path_read("arr_root", [Phys.PathHalf{True{}, ref("U32", Nil{})}], w))
  b = show_part(Phys.path_copy("arr_root", [Phys.PathHalf{False{}, ref("U32", Nil{})}], w))
  c = show_part(Phys.path_consume("arr_leaf", [Phys.PathLeafCell{ref("U32", Nil{})}], w))
  d = show_part(Phys.path_is_leaf("arr_root", [Phys.PathHalf{True{}, ref("U32", Nil{})}], w))
  e = show_part(Phys.path_is_node("arr_root", [Phys.PathHalf{True{}, ref("U32", Nil{})}], w))
  String.append(a, String.append(b, String.append(c, String.append(d, e))))

def main(modules: List<&2, Loader.LoadedModule>) -> ViewSmoke:
  ViewSmoke{String.append(pair_parts(world()), String.append(seg_parts(world()), String.append(box_parts(world()), array_parts(world()))))}
