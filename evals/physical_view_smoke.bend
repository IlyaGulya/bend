import Base
import ../bend2/selfhost/loaded_module.bend as Loader
import ../bend2/selfhost/backend_ir.bend as BIR
import ../bend2/selfhost/c_backend_layout.bend as CLay
import ../bend2/selfhost/c_backend_physical.bend as Phys

# Phys Project view smoke: the setup/field/discard/release text of the grouped
# view for a nested Seg and a plain Pair, generated by the canonical physical
# module. The host compiles the emitted expressions with the real runtime when
# the control grouping lands; this fixture proves the view is reachable and
# admitted by the canonical source pass.

type ViewSmoke is Data:
  ViewSmoke{text: String}

def fld(+ty: BIR.Descriptor) -> BIR.DescriptorField:
  BIR.DescriptorField{None{}, BIR.Unrestricted{}, ty}

def arm(+key: String, +fields: List<&2, BIR.DescriptorField>) -> BIR.DescriptorArm:
  BIR.DescriptorArm{key, fields}

def ref(+key: String, +args: List<&2, BIR.Descriptor>) -> BIR.Descriptor:
  BIR.DescriptorRef{key, args}

def fam(+key: String, +native: Maybe<&2, String>, +arms: List<&2, BIR.DescriptorArm>) -> BIR.Family:
  BIR.Family{key, key, native, 0n, 0n, arms}

def families() -> List<&2, BIR.Family>:
  [
    fam("U32", Some{"U32"}, Nil{}),
    fam("Pt", None{}, [arm("Pt", [fld(ref("U32", Nil{})), fld(ref("U32", Nil{}))])]),
    fam("Fl", None{}, [arm("Fl", [fld(ref("U32", Nil{}))])]),
    fam("Pair", None{}, [arm("Pair", [fld(ref("U32", Nil{})), fld(ref("U32", Nil{}))])]),
    fam("Seg", None{}, [arm("Seg", [fld(ref("Pt", Nil{})), fld(ref("Pt", Nil{})), fld(ref("Fl", Nil{}))])])
  ]

def row(+id: U32, +key: String, +arity: Nat) -> BIR.ConstructorLayout:
  BIR.ConstructorLayout{id, key, None{}, List.replicate(Maybe<&2, String>, arity, None{})}

def constructors() -> List<&2, BIR.ConstructorLayout>:
  [row(0, "Pair", 2n), row(1, "Pt", 2n), row(2, "Fl", 1n), row(3, "Seg", 3n)]

def program() -> BIR.Program:
  BIR.Program{Nil{}, Nil{}, constructors(), families(), Nil{}, BIR.Executable{BIR.DescriptorRef{"U32", Nil{}}}}

def world() -> Phys.World:
  ctx = CLay.context(program())
  Phys.world(ctx, constructors(), families(), [Phys.CidSym{0, "Pair"}, Phys.CidSym{1, "Pt"}, Phys.CidSym{2, "Fl"}, Phys.CidSym{3, "Seg"}])

def show_field(+field: Phys.ProjectField) -> String:
  match field:
    case Phys.ProjectField{ordinal, expr, discard}:
      String.append(U32.show(ordinal), String.append("|", String.append(expr, String.append("|", String.append(discard, "\n")))))

def show_fields(+fields: List<&2, Phys.ProjectField>) -> String:
  match fields:
    case Nil{}: ""
    case +field <> rest: String.append(show_field(field), show_fields(rest))

def show_view(+v: Phys.ProjectView) -> String:
  match v:
    case Phys.ProjectView{setup, fields, release}:
      String.append("SETUP ", String.append(setup, String.append("\nFIELDS\n", String.append(show_fields(fields), String.append("RELEASE ", String.append(release, "\n"))))))
    case Phys.ProjectViewFail{message}: String.append("FAIL ", String.append(message, "\n"))

def pair_view(+w: Phys.World) -> String:
  show_view(Phys.project_view("pair_value", 0, w))

def seg_view(+w: Phys.World) -> String:
  show_view(Phys.project_view("seg_value", 3, w))

def main() -> ViewSmoke:
  ViewSmoke{String.append(pair_view(world()), seg_view(world()))}
