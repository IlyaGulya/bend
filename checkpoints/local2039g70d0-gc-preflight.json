  "exactProbeSource": "import{readFileSync,writeFileSync,realpathSync,existsSync}from'node:fs';\nimport{resolve,dirname,isAbsolute,posix}from'node:path';\nimport{pathToFileURL}from'node:url';\nimport{createHash}from'node:crypto';\nimport{Worker,isMainThread,workerData,threadId}from'node:worker_threads';\nimport{getHeapStatistics,getHeapSpaceStatistics}from'node:v8';\nimport{PerformanceObserver,performance,constants}from'node:perf_hooks';\nconst hash=path=>createHash('sha256').update(readFileSync(path)).digest('hex');\nconst[requestPath,reportPath]=process.argv.slice(2);\nif(isMainThread){\n if(process.argv.length!==4||!requestPath||!reportPath||existsSync(reportPath))throw Error('Expected REQUEST FRESH_REPORT');\n const worker=new Worker(new URL(import.meta.url),{workerData:{requestPath,reportPath},resourceLimits:{stackSizeMb:256,maxOldGenerationSizeMb:6144,maxYoungGenerationSizeMb:128}});\n await new Promise((done,reject)=>{worker.once('error',reject);worker.once('exit',code=>code===0?done():reject(Error('GC diagnostic worker exit '+code)));});\n}else{\n const request=JSON.parse(readFileSync(workerData.requestPath,'utf8'));\n if(request.schemaVersion!==1||request.kind!=='gc-timeline'||request.sampleEvery!==16384)throw Error('Invalid GC diagnostic request');\n const verify=()=>{for(const[path,digest]of Object.entries({...request.pins,...request.inputs}))if(realpathSync(path)!==path||hash(path)!==digest)throw Error('Pinned input drift: '+path);};verify();\n const{runTemplateSteps,runCheckerSteps}=await import(pathToFileURL(request.runtimeHelper).href);\n const tag=x=>typeof x?.$==='string'?x.$.split('.').at(-1):null;\n const items=x=>{const a=[];while(tag(x)==='Con'){a.push(x.head);x=x.tail;}if(tag(x)!=='Nil')throw Error('Malformed native list');return a;};\n const list=a=>a.reduceRight((tail,head)=>({$:'Con',head,tail}),{$:'Nil'});\n const end=Object.freeze({$:'FeedbackFuelEnd'}),fuelProto={get tail(){return fuel(this.remaining-1);}};\n const fuel=n=>{if(n===0)return end;const x=Object.create(fuelProto);x.$='FeedbackFuelCell';x.remaining=n;return x;};\n const owner=run=>{const progress=run?.progress;let request=progress?.request;const chain=[];for(let i=0;i<24&&request&&typeof request==='object';i++){chain.push(typeof request.$==='string'?request.$:null);if(!tag(request)?.startsWith('CheckerRequestGroup_'))break;request=request.request;}const stack=run?.stack,resume=stack?.resume;return{progressTag:progress?.$,requestChain:chain,stackTag:stack?.$,resumeName:typeof resume==='function'?resume.name:null,resumeSource:typeof resume==='function'?Function.prototype.toString.call(resume).slice(0,240):null};};\n const gc=[];const collect=entries=>{for(const entry of entries)gc.push({startTime:entry.startTime,duration:entry.duration,kind:entry.detail?.kind,flags:entry.detail?.flags});};\n const observer=new PerformanceObserver(list=>collect(list.getEntries()));observer.observe({entryTypes:['gc']});\n const result={schemaVersion:1,status:'RUNNING',diagnosticOnly:true,performanceEvidence:false,acceptanceEvidence:false,kind:request.kind,image:request.image,imageSha256:hash(request.image),request:workerData.requestPath,requestSha256:hash(workerData.requestPath),pid:process.pid,threadId,runtime:{versions:process.versions,execArgv:process.execArgv,heapLimitBytes:getHeapStatistics().heap_size_limit},workerPolicy:{stackMiB:256,oldGenerationMiB:6144,youngGenerationMiB:128},sampleEvery:request.sampleEvery,timeOrigin:performance.timeOrigin,gcConstants:Object.fromEntries(Object.entries(constants).filter(([name])=>name.startsWith('NODE_PERFORMANCE_GC_'))),phases:[],boundaries:[],stepCounts:{},note:'No inspector, allocation sampler, snapshot, forcedGC, image patch or AST replay. Heap used includes garbage; sampled maxima are not actual maxima/live/retained. GC events delivered asynchronously after synchronous checker; use recorded startTime, not callback time. Timings and guarded peaks are diagnostic, not clean performance evidence.'};\n const memory=(label,step,run)=>({label,step,atMs:performance.now(),requestOwner:run?owner(run):undefined,memory:process.memoryUsage(),heapStatistics:getHeapStatistics(),spaces:getHeapSpaceStatistics()});\n const save=()=>writeFileSync(workerData.reportPath,JSON.stringify(result,null,2)+'\\n');\n const phase=(name,action)=>{result.activePhase=name;save();const startMs=performance.now(),value=action(),endMs=performance.now();result.phases.push({phase:name,startMs,endMs,elapsedMs:endMs-startMs});delete result.activePhase;result.boundaries.push(memory(name+'-end'));save();return value;};\n try{\n  const startup=performance.now(),api=(await import(pathToFileURL(request.image).href)).default;\n  result.phases.push({phase:'startup',startMs:startup,endMs:performance.now(),elapsedMs:performance.now()-startup});result.boundaries.push(memory('startup-end'));\n  if(!request.exports.every(key=>typeof api?.[key]==='function'))throw Error('Compiler ABI incomplete');\n  let modules=[],declarations=0;const seen=new Map();\n  phase('load-parse',()=>{\n   const active=new Set(),observed=new Set();\n   const observe=path=>{const p=realpathSync(path);if(!Object.hasOwn(request.inputs,p))throw Error('Unexpected input '+p);observed.add(p);return p;};\n   const namespace=(scope,path)=>path==='Base'?'':posix.normalize(isAbsolute(path)?path.replace(/\\.bend$/,''):posix.dirname(scope)+'/'+path.replace(/\\.bend$/,''));\n   const visit=(file,scope)=>{\n    const p=observe(file);if(active.has(p))throw Error('Import cycle');if(seen.has(p)){if(seen.get(p)!==scope)throw Error('Namespace conflict');return;}seen.set(p,scope);active.add(p);\n    const feedback=api.parse_with_fuel(fuel(8000000),p,readFileSync(p,'utf8'));if(tag(feedback)!=='FeedbackComplete'||tag(feedback.value.result)!=='ParseSuccess')throw Error('Own parse rejected '+p);\n    const module=feedback.value.result.module;declarations+=items(module.declarations).length;\n    for(const top of items(module.declarations))if(tag(top)==='DefTop'&&tag(top.definition.body)==='DefImports')for(const path of items(top.definition.body.paths))if(path.endsWith('.js'))observe(resolve(dirname(p),path));\n    for(const imported of items(module.imports)){const path=imported.path;if(path.endsWith('.js'))observe(resolve(dirname(p),path));else if(!path.endsWith('.c'))visit(path==='Base'?resolve(request.repository,'bend2/base.bend'):resolve(dirname(p),path),namespace(scope,path));}\n    modules.push(api.parsed_module(scope,module));active.delete(p);\n   };\n   visit(request.root,'');if(observed.size!==Object.keys(request.inputs).length)throw Error('Own parser omitted a frozen input');result.moduleCount=seen.size;result.sourceDeclarations=declarations;modules=list(modules);\n  });\n  let expanded=phase('expand',()=>runTemplateSteps({...api,expand_modules_start:input=>{modules=undefined;return api.expand_modules_start(input);}},modules,{onFinish(_,steps){result.stepCounts.expand=steps;}}));\n  if(tag(expanded)!=='ExpandSuccess')throw Error('Own expansion failure');\n  let checked=phase('check',()=>runCheckerSteps({...api,check_expanded_start:input=>{expanded=undefined;return api.check_expanded_start(input);}},expanded.modules,{onStep(step,run){if(step%request.sampleEvery===0)result.boundaries.push(memory('check-step',step,run));},onFinish(_,steps){result.stepCounts.check=steps;}}));\n  if(tag(checked)!=='CheckSuccess')throw Error('Own checker failure');result.fullCheckSuccess=true;result.boundaries.push(memory('check-result-held',result.stepCounts.check));checked=undefined;result.boundaries.push(memory('check-result-released-no-forced-GC',result.stepCounts.check));\n  for(const key of ['moduleCount','sourceDeclarations'])if(result[key]!==request.expected[key])throw Error('Frozen work differs: '+key);\n  if(JSON.stringify(result.stepCounts)!==JSON.stringify(request.expected.stepCounts))throw Error('Frozen opaque step counters differ');\n  for(let i=0;i<3;i++)await new Promise(done=>setImmediate(done));collect(observer.takeRecords());observer.disconnect();\n  result.settleTurns=3;result.gcEvents=gc.sort((a,b)=>a.startTime-b.startTime).map(entry=>({...entry,phase:result.phases.find(phase=>entry.startTime>=phase.startMs&&entry.startTime<phase.endMs)?.phase??'interphase-or-settle'}));\n  result.finalMemory=memory('after-settle-no-forced-GC');result.sampledOccupiedHeapMaximum=Math.max(...result.boundaries.map(row=>row.memory.heapUsed));result.sampledCommittedPhysicalMaximum=Math.max(...result.boundaries.map(row=>row.heapStatistics.total_physical_size));\n  verify();result.status='PASS_FULL_FROZEN_OWN_CHECK_GC_DIAGNOSTIC';save();console.log(JSON.stringify({status:result.status,report:workerData.reportPath,moduleCount:result.moduleCount,sourceDeclarations:result.sourceDeclarations,stepCounts:result.stepCounts,boundarySamples:result.boundaries.length,gcEvents:result.gcEvents.length,sampledOccupiedHeapMaximum:result.sampledOccupiedHeapMaximum,scope:'Diagnostic only; not peak-live or clean CPU/RAM comparison'}));\n }catch(error){observer.disconnect();result.status='FAIL';result.error=String(error);result.stack=error?.stack;save();throw error;}\n}\n",
