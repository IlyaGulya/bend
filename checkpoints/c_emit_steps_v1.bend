def cemit_step_one(request: CEmitterRequest) -> CEmitterProgress<cemit_result(request)>:
  match request:
    case CEmitterRequestGroup_0{inner}: cemit_step_group_0(inner)
    case CEmitterRequestGroup_1{inner}: cemit_step_group_1(inner)
    case CEmitterRequestGroup_2{inner}: cemit_step_group_2(inner)
    case CEmitterRequestGroup_3{inner}: cemit_step_group_3(inner)
    case CEmitterRequestGroup_4{inner}: cemit_step_group_4(inner)
    case CEmitterRequestGroup_5{inner}: cemit_step_group_5(inner)
    case CEmitterRequestGroup_6{inner}: cemit_step_group_6(inner)
    case CEmitterRequestGroup_7{inner}: cemit_step_group_7(inner)
    case CEmitterRequestGroup_8{inner}: cemit_step_group_8(inner)
    case CEmitterRequestGroup_9{inner}: cemit_step_group_9(inner)
    case CEmitterRequestGroup_10{inner}: cemit_step_group_10(inner)
    case CEmitterRequestGroup_11{inner}: cemit_step_group_11(inner)
    case CEmitterRequestGroup_12{inner}: cemit_step_group_12(inner)
    case CEmitterRequestGroup_13{inner}: cemit_step_group_13(inner)
    case CEmitterRequestGroup_14{inner}: cemit_step_group_14(inner)
    case CEmitterRequestGroup_15{inner}: cemit_step_group_15(inner)
    case CEmitterRequestGroup_16{inner}: cemit_step_group_16(inner)
    case CEmitterRequestGroup_17{inner}: cemit_step_group_17(inner)
    case CEmitterRequestGroup_18{inner}: cemit_step_group_18(inner)
    case CEmitterRequestGroup_19{inner}: cemit_step_group_19(inner)
    case CEmitterRequestGroup_20{inner}: cemit_step_group_20(inner)
    case CEmitterRequestGroup_21{inner}: cemit_step_group_21(inner)

def cemit_pop(-A: Type, -R: Type, stack: CEmitterStack<A, R>, box: CEmitterValue<A>) -> CEmitterRun<R>:
  match stack:
    case CEmitterStackDone{equation}: CEmitterRunFinished{cemit_cast_box(A, R, equation, box)}
    case CEmitterStackMore{B, resume, rest}: CEmitterRunState{B, resume(box), rest}

def cemit_advance(-A: Type, -R: Type, progress: CEmitterProgress<A>, stack: CEmitterStack<A, R>) -> CEmitterRun<R>:
  match progress:
    case CEmitterFinished{box}: cemit_pop(A, R, stack, box)
    case CEmitterPending{request, resume}:
      CEmitterRunState{cemit_result(request), cemit_step_one(request), CEmitterStackMore{A, resume, stack}}
    case CEmitterDirect{T, request, arguments, invoke, resume}:
      CEmitterRunState{cemit_result(request), invoke(arguments), CEmitterStackMore{A, resume, stack}}
    case CEmitterBound{B, inner, resume}:
      CEmitterRunState{B, inner, CEmitterStackMore{A, resume, stack}}

def cemit_chunk(-R: Type, fuel: Nat, run: CEmitterRun<R>) -> CEmitterRun<R>:
  match fuel run:
    case 0n state: state
    case 1n+rest CEmitterRunFinished{box}: CEmitterRunFinished{box}
    case 1n+rest CEmitterRunState{A, progress, stack}:
      cemit_chunk(R, rest, cemit_advance(A, R, progress, stack))

def cemit_step(-R: Type, run: CEmitterRun<R>) -> CEmitterRun<R>:
  cemit_chunk(R, 64n, run)

def cemit_start(program: Checked.CheckedProgram, runtime: String, files: List<&2, BIR.SourceFile>) -> CEmitterRun<EmitResult>:
  cemit_chunk(EmitResult, 64n, CEmitterRunState{EmitResult, CEmitterPending{CEmitterRequestGroup_0{CEmitterRequest_emit{program, runtime, files}}, box => CEmitterFinished{box}}, CEmitterStackDone{{==}}})

def cemit_library_start(program: Checked.CheckedProgram, exports: List<&2, String>, runtime: String, files: List<&2, BIR.SourceFile>) -> CEmitterRun<EmitResult>:
  cemit_chunk(EmitResult, 64n, CEmitterRunState{EmitResult, CEmitterPending{CEmitterRequestGroup_0{CEmitterRequest_emit_library{program, exports, runtime, files}}, box => CEmitterFinished{box}}, CEmitterStackDone{{==}}})
