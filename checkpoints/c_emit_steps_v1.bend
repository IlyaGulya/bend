# Bounded typed request groups; every source declaration retains its checked signature.
type CEmitterRequestGroup0 is Type:
  CEmitterRequest_no_span{}
  CEmitterRequest_foreign_c_source{v_2: List<&2, String>}
  CEmitterRequest_plan_prepend{v_1: PlanResult, v_3: CImportPlan}
  CEmitterRequest_plan_add{+v_1: String, +v_3: String, v_4: Ast.SourceSpan, v_7: List<&2, CImportPlan>}
  CEmitterRequest_plan_declaration{v_0: BIR.Declaration, +v_3: List<&2, CImportPlan>}
  CEmitterRequest_plan_declarations{v_1: List<&2, BIR.Declaration>, +v_4: List<&2, CImportPlan>}
  CEmitterRequest_find_source{+v_1: String, v_3: List<&2, BIR.SourceFile>}
  CEmitterRequest_join_imports{v_2: List<&2, CImportPlan>, +v_4: List<&2, BIR.SourceFile>, v_7: List<&2, cps_provider_2_CImport>}
