 args, u32 n) {\n", "  if (i >= BEND_EXPORT_COUNT) { err_fail(\"bend: export index out of range\"); }\n", "  u32 ar = BEND_EXPORT_ARITY[i];\n", "  if (BEND_EXPORT_MODE[i] == 0) {\n    if (n != ar) { err_fail(\"bend: export called at the wrong arity\"); }\n    return bend_export_run(BEND_EXPORT_ENTRY[i], args, n);\n  }\n", "  if (BEND_EXPORT_MODE[i] == 2) {\n    if (n < ar) { err_fail(\"bend: export called with too few arguments\"); }\n    Term v = bend_export_run(BEND_EXPORT_ENTRY[i], args, ar);\n    for (u32 j = ar; j < n; j += 1) { v = bend_export_apply_one(v, args[j]); }\n    return v;\n  }\n", "  Term v = bend_export_run(BEND_EXPORT_ENTRY[i], 0, 0);\n  for (u32 j = 0; j < n; j += 1) { v = bend_export_apply_one(v, args[j]); }\n  return v;\n}\n"])}}}}

