    case EmitterRequestGroup_33{inner}: emitter_step_group_33(inner)
    case EmitterRequestGroup_34{inner}: emitter_step_group_34(inner)
    case EmitterRequestGroup_35{inner}: emitter_step_group_35(inner)
    case EmitterRequestGroup_36{inner}: emitter_step_group_36(inner)
    case EmitterRequestGroup_37{inner}: emitter_step_group_37(inner)
    case EmitterRequestGroup_38{inner}: emitter_step_group_38(inner)
    case EmitterRequestGroup_39{inner}: emitter_step_group_39(inner)
    case EmitterRequestGroup_40{inner}: emitter_step_group_40(inner)
    case EmitterRequestGroup_41{inner}: emitter_step_group_41(inner)

def emitter_pop(-A: Type, -R: Type, stack: EmitterStack<A, R>, box: EmitterValue<A>) -> EmitterRun<R>:
  match stack:
    case EmitterStackDone{equation}: EmitterRunFinished{emitter_cast_box(A, R, equation, box)}
    case EmitterStackMore{B, resume, rest}: EmitterRunState{B, resume(box), rest}

def emitter_advance(-A: Type, -R: Type, progress: EmitterProgress<A>, stack: EmitterStack<A, R>) -> EmitterRun<R>:
  match progress:
    case EmitterFinished{box}: emitter_pop(A, R, stack, box)
    case EmitterPending{request, resume}:
      EmitterRunState{emitter_result(request), emitter_step_one(request), EmitterStackMore{A, resume, stack}}
    case EmitterDirect{T, request, arguments, invoke, resume}:
      EmitterRunState{emitter_result(request), invoke(arguments), EmitterStackMore{A, resume, stack}}
    case EmitterBound{B, inner, resume}:
      EmitterRunState{B, inner, EmitterStackMore{A, resume, stack}}

def emitter_chunk(-R: Type, fuel: Nat, run: EmitterRun<R>) -> EmitterRun<R>:
  match fuel run:
    case 0n state: state
    case 1n+rest EmitterRunFinished{box}: EmitterRunFinished{box}
    case 1n+rest EmitterRunState{A, progress, stack}:
      emitter_chunk(R, rest, emitter_advance(A, R, progress, stack))

def emitter_step(-R: Type, run: EmitterRun<R>) -> EmitterRun<R>:
  emitter_chunk(R, 64n, run)

def emitter_start(program: Checked.CheckedProgram, files: List<&2, BIR.SourceFile>) -> EmitterRun<EmitResult>:
  emitter_chunk(EmitResult, 64n, EmitterRunState{EmitResult, EmitterPending{EmitterRequestGroup_0{EmitterRequest_emit{program, files}}, box => EmitterFinished{box}}, EmitterStackDone{{==}}})

def emitter_library_start(program: Checked.CheckedProgram, exports: List<&2, String>, files: List<&2, BIR.SourceFile>) -> EmitterRun<EmitResult>:
  emitter_chunk(EmitResult, 64n, EmitterRunState{EmitResult, EmitterPending{EmitterRequestGroup_0{EmitterRequest_emit_library{program, exports, files}}, box => EmitterFinished{box}}, EmitterStackDone{{==}}})

def cemit_start(program: Checked.CheckedProgram, runtime: String, files: List<&2, BIR.SourceFile>) -> EmitterRun<EmitResult>:
  emitter_chunk(EmitResult, 64n, EmitterRunState{EmitResult, EmitterPending{EmitterRequestGroup_0{EmitterRequest_emit_c{program, runtime, files}}, box => EmitterFinished{box}}, EmitterStackDone{{==}}})

def cemit_library_start(program: Checked.CheckedProgram, exports: List<&2, String>, runtime: String, files: List<&2, BIR.SourceFile>) -> EmitterRun<EmitResult>:
  emitter_chunk(EmitResult, 64n, EmitterRunState{EmitResult, EmitterPending{EmitterRequestGroup_0{EmitterRequest_emit_c_library{program, exports, runtime, files}}, box => EmitterFinished{box}}, EmitterStackDone{{==}}})
