+// Exact free binder IDs, as interpreted by term_higher. Query metadata only.
+export function term_occurs(t: LTerm, i: number): boolean {
+  return term_occurs_go(t, i, new WeakMap());
+}
+
+function term_occurs_any(xs: readonly (LTerm | Patt)[], i: number, memo: WeakMap<object, boolean>): boolean {
+  for (const x of xs) if (term_occurs_go(x, i, memo)) return true;
+  return false;
+}
+
+function term_occurs_go(t: LTerm | Patt, i: number, memo: WeakMap<object, boolean>): boolean {
+  const known = memo.get(t);
+  if (known !== undefined) return known;
+  const has = term_occurs_go;
+  let found: boolean;
+  switch (t.$) {
+    case "Var": case "PVar": found = t.i === i; break;
+    case "Ref": case "Qnt": case "Qua": case "Efq": case "Rfl": case "Hol":
+      found = false; break;
+    case "Sub":
+      found = has(t.v, i, memo) || (t.i !== i && has(t.f, i, memo)); break;
+    case "Let":
+      found = term_occurs_any(t.v, i, memo) || (!t.i.includes(i) && has(t.f, i, memo)); break;
+    case "Typ": found = has(t.g, i, memo); break;
+    case "Min": found = has(t.a, i, memo) || has(t.b, i, memo); break;
+    case "All": found = has(t.A, i, memo) || (t.i !== i && has(t.B, i, memo)); break;
+    case "Lam": found = t.i !== i && has(t.f, i, memo); break;
+    case "App": found = has(t.f, i, memo) || has(t.x, i, memo); break;
+    case "ADT": case "Ctr": case "PCtr": found = term_occurs_any(t.x, i, memo); break;
+    case "Mat": found = has(t.h, i, memo) || has(t.m, i, memo); break;
+    case "Eql": found = has(t.a, i, memo) || has(t.b, i, memo) || has(t.T, i, memo); break;
+    case "Rwt": found = has(t.e, i, memo) || has(t.p, i, memo) || has(t.f, i, memo); break;
+    case "Ann": found = has(t.x, i, memo) || has(t.T, i, memo); break;
+  }
+  memo.set(t, found);
+  return found;
+}
