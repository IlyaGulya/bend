  "preloaderSource": "import{isMainThread}from'node:worker_threads';\nimport{readFileSync,writeFileSync,realpathSync}from'node:fs';\nimport{createHash}from'node:crypto';import{pathToFileURL}from'node:url';import{Session}from'node:inspector';\nif(!isMainThread){\n const configPath=process.env.G68_ARENA_ACTIVATION_CONFIG;\n if(!configPath)throw Error('Missing activation diagnostic config');\n const config=JSON.parse(readFileSync(configPath,'utf8'));\n const target=realpathSync(config.image.path),digest=createHash('sha256').update(readFileSync(target)).digest('hex');\n if(digest!==config.image.sha256)throw Error('Activation target image drift');\n const session=new Session();session.connect();\n const sites=new Map(),hits=new Map(),errors=[],resolutions=[];\n const post=(method,params={})=>new Promise((resolve,reject)=>session.post(method,params,(error,result)=>error?reject(error):resolve(result)));\n session.on('Debugger.breakpointResolved',({params})=>resolutions.push(params));\n session.on('Debugger.paused',({params})=>{\n  try{\n   for(const id of params.hitBreakpoints??[]){\n    const site=sites.get(id);if(!site)continue;\n    if(!hits.has(site.owner))hits.set(site.owner,{owner:site.owner,requested:site,breakpointId:id,reason:params.reason,frames:params.callFrames.slice(0,5).map(frame=>({functionName:frame.functionName,url:frame.url,location:frame.location}))});\n    session.post('Debugger.removeBreakpoint',{breakpointId:id},error=>{if(error)errors.push(String(error));});\n   }\n  }catch(error){errors.push(String(error));}\n  finally{session.post('Debugger.resume',{},error=>{if(error)errors.push(String(error));});}\n });\n await post('Debugger.enable');\n for(const site of config.sites){\n  const point=await post('Debugger.setBreakpointByUrl',{url:pathToFileURL(target).href,lineNumber:site.lineNumber,columnNumber:site.columnNumber});\n  sites.set(point.breakpointId,site);for(const location of point.locations??[])resolutions.push({breakpointId:point.breakpointId,location});\n }\n process.once('exit',code=>{\n  const result={schemaVersion:1,status:code===0&&hits.size===config.sites.length&&errors.length===0?'BOTH_REAL_COMPILER_VIRTUAL_READ_SITES_EXECUTED':'ACTIVATION_NOT_PROVED',diagnosticOnly:true,acceptanceTiming:false,image:config.image,configPath,execArgv:process.execArgv,node:process.version,v8:process.versions.v8,hits:[...hits.values()],resolutions,errors,exitCode:code,outputPatches:0,manualGC:false,meaning:'Inspector breakpoint at actual inlined virtualnativeGETread in each realArena.word/get_node function. Whole actual frozen checker run must separately PASS with unchanged counters. No target source evaluation/patching, no forcedGC, not cleanCPU/RAMmeasurement.'};\n  writeFileSync(config.output,JSON.stringify(result,null,2)+'\\n',{flag:'wx'});\n });\n}\n",
