def cps_provider_8_quantity(v_0: BIR.Quantity) -> String:
  match v_0:
    case BIR.Erased{}:
      "0"
    case BIR.Once{}:
      "1"
    case BIR.Unrestricted{}:
      "2"

def cps_provider_8_optional_quantity(v_1: Maybe<&2, BIR.Quantity>) -> String:
  match v_1:
    case None{}:
      "null"
    case Some{v_4}:
      cps_provider_8_quantity(v_4)

def cps_provider_8_quantities(v_1: List<&2, BIR.Quantity>) -> List<&2, String>:
  match v_1:
    case []:
      []
    case v_6 <> v_7:
      cps_provider_8_quantity(v_6) <> cps_provider_8_quantities(v_7)

def cps_provider_8_descriptor_pattern(v_0: BIR.DescriptorPattern) -> String:
  match v_0:
    case BIR.DescriptorBinder{v_3}:
      cps_provider_8_cat(["({v:true,q:", cps_provider_8_quantity(v_3), "})"])
    case BIR.DescriptorConstructorPattern{v_8, v_9}:
      cps_provider_8_cat(["({c:", cps_provider_8_js_quote(v_8), ",s:\"\",i:{},fields:[", String.join(cps_provider_8_descriptor_patterns(v_9), ","), "]})"])

def cps_provider_8_descriptor_patterns(v_1: List<&2, BIR.DescriptorPattern>) -> List<&2, String>:
  match v_1:
    case []:
      []
    case v_6 <> v_7:
      cps_provider_8_descriptor_pattern(v_6) <> cps_provider_8_descriptor_patterns(v_7)

def cps_provider_8_descriptors(v_1: List<&2, BIR.Descriptor>) -> List<&2, String>:
  match v_1:
    case []:
      []
    case v_6 <> v_7:
      cps_provider_8_descriptor(v_6) <> cps_provider_8_descriptors(v_7)

def cps_provider_8_descriptor(v_0: BIR.Descriptor) -> String:
  match v_0:
    case BIR.DescriptorNull{}:
      cps_provider_8_cat(["null"])
    case BIR.DescriptorRef{v_5, v_6}:
      cps_provider_8_cat(["({r:", cps_provider_8_js_quote(v_5), ",a:[", String.join(cps_provider_8_descriptors(v_6), ","), "],s:\"\",i:{}})"])
    case BIR.DescriptorParameter{v_11}:
      cps_provider_8_cat(["({p:", Nat.show(v_11), "})"])
    case BIR.DescriptorQuantityKind{}:
      cps_provider_8_cat(["({k:\"QK\"})"])
    case BIR.DescriptorQuantity{v_14}:
      cps_provider_8_cat(["({k:\"Q\",v:", cps_provider_8_quantity(v_14), "})"])
    case BIR.DescriptorKind{v_17}:
      cps_provider_8_cat(["({kind:", cps_provider_8_descriptor(v_17), "})"])
    case BIR.DescriptorMinimum{v_22, v_23}:
      cps_provider_8_cat(["({min:", cps_provider_8_descriptor(v_22), ",right:", cps_provider_8_descriptor(v_23), "})"])
    case BIR.DescriptorArrow{v_30, v_31, v_32}:
      cps_provider_8_cat(["({all:", cps_provider_8_descriptor(v_31), ",q:", cps_provider_8_quantity(v_30), ",body:", cps_provider_8_descriptor(v_32), "})"])
    case BIR.DescriptorLambda{v_39, v_40}:
      cps_provider_8_cat(["({lam:", cps_provider_8_descriptor(v_40), ",q:", cps_provider_8_optional_quantity(v_39), "})"])
    case BIR.DescriptorConstructor{v_46, v_47}:
      cps_provider_8_cat(["({c:", cps_provider_8_js_quote(v_46), ",a:[", String.join(cps_provider_8_descriptors(v_47), ","), "],s:\"\",i:{}})"])
    case BIR.DescriptorApplication{v_53, v_54}:
      cps_provider_8_cat(["({app:", cps_provider_8_descriptor(v_53), ",arg:", cps_provider_8_descriptor(v_54), "})"])
    case BIR.DescriptorSubstitution{v_60, v_61, v_62}:
      cps_provider_8_cat(["({sub:", Nat.show(v_60), ",value:", cps_provider_8_descriptor(v_61), ",body:", cps_provider_8_descriptor(v_62), "})"])
    case BIR.DescriptorLet{v_68, v_69}:
      cps_provider_8_cat(["({let:[", String.join(cps_provider_8_descriptors(v_68), ","), "],body:", cps_provider_8_descriptor(v_69), "})"])
    case BIR.DescriptorLocal{v_76, v_77, v_78}:
      cps_provider_8_cat(["({local:[", String.join(cps_provider_8_descriptors(v_77), ","), "],pat:[", String.join(cps_provider_8_descriptor_patterns(v_76), ","), "],body:", cps_provider_8_descriptor(v_78), "})"])
    case BIR.DescriptorMatch{v_85, v_86}:
      cps_provider_8_cat(["({match:[", String.join(cps_provider_8_descriptors(v_85), ","), "],cases:[", String.join(cps_provider_8_descriptors(v_86), ","), "]})"])
    case BIR.DescriptorCase{v_92, v_93}:
      cps_provider_8_cat(["({pat:[", String.join(cps_provider_8_descriptor_patterns(v_92), ","), "],body:", cps_provider_8_descriptor(v_93), "})"])
    case BIR.DescriptorBind{v_98, v_99}:
      cps_provider_8_cat(["({bind:", cps_provider_8_descriptor(v_98), ",body:", cps_provider_8_descriptor(v_99), "})"])
    case BIR.DescriptorEquality{v_106, v_107, v_108}:
      cps_provider_8_cat(["({k:\"E\",left:", cps_provider_8_descriptor(v_106), ",right:", cps_provider_8_descriptor(v_107), ",ty:", cps_provider_8_descriptor(v_108), "})"])
    case BIR.DescriptorReflexivity{}:
      cps_provider_8_cat(["({k:\"Refl\"})"])
    case BIR.DescriptorFailure{v_115}:
      cps_provider_8_cat(["({fail:", cps_provider_8_js_quote(v_115), "})"])
    case BIR.DescriptorFill{v_120, v_121}:
      cps_provider_8_cat(["({sugar:", cps_provider_8_descriptor(v_120), ",a:[", String.join(cps_provider_8_descriptors(v_121), ","), "],f:1})"])
