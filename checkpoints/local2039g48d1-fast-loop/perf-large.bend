    case PerfRequest_1_5{left, right}:
      PerfFinished{PerfValue{U32.is_lt(U32.add(left, 21), right)}}
    case PerfRequest_1_6{values, bias}:
      PerfFinished{PerfValue{Perf.shift(values, U32.add(bias, 22))}}
    case PerfRequest_1_7{payload, bias}:
      PerfFinished{PerfValue{Perf.payload_pair(payload, U32.add(bias, 23))}}
    case PerfRequest_1_8{left, right}:
      PerfFinished{PerfValue{U32.add(U32.add(left, right), 24)}}
