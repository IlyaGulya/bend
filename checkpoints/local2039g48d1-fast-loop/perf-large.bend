def Perf.result(request: PerfRequest) -> Type:
  match request:
    case PerfRequestGroup_0{inner}: Perf.result_group_0(inner)
    case PerfRequestGroup_1{inner}: Perf.result_group_1(inner)
    case PerfRequestGroup_2{inner}: Perf.result_group_2(inner)
    case PerfRequestGroup_3{inner}: Perf.result_group_3(inner)

# END PERF REQUESTS

# Exact generic scheduler schema, alpha-renamed from checker_core_steps_v1.bend.

type PerfProgress<-A: Type> is Type:
  PerfFinished{box: PerfValue<A>}
  PerfPending{request: PerfRequest, resume: (@box: PerfValue<Perf.result(request)> -> PerfProgress<A>)}
  PerfDirect{-R: Type, -request: PerfRequest, arguments: R, invoke: (@arguments: R -> PerfProgress<Perf.result(request)>), resume: (@box: PerfValue<Perf.result(request)> -> PerfProgress<A>)}
  PerfBound{-B: Type, inner: PerfProgress<B>, resume: (@box: PerfValue<B> -> PerfProgress<A>)}

type PerfStack<-A: Type, -R: Type> is Type:
  PerfStackDone{equation: {A == R : Type}}
  PerfStackMore{-B: Type, resume: (@box: PerfValue<A> -> PerfProgress<B>), rest: PerfStack<B, R>}

type PerfRun<-R: Type> is Type:
  PerfRunFinished{box: PerfValue<R>}
  PerfRunState{-A: Type, progress: PerfProgress<A>, stack: PerfStack<A, R>}

# BEGIN PERF DISPATCH
def Perf.step_group_0(request: PerfRequestGroup0) -> PerfProgress<Perf.result_group_0(request)>:
  match request:
    case PerfRequest_0_0{left, right}:
      PerfFinished{PerfValue{U32.add(U32.add(left, right), 0)}}
    case PerfRequest_0_1{left, right}:
      PerfFinished{PerfValue{U32.is_lt(U32.add(left, 1), right)}}
    case PerfRequest_0_2{values, bias}:
      PerfFinished{PerfValue{Perf.shift(values, U32.add(bias, 2))}}
    case PerfRequest_0_3{payload, bias}:
      PerfFinished{PerfValue{Perf.payload_pair(payload, U32.add(bias, 3))}}
    case PerfRequest_0_4{left, right}:
      PerfFinished{PerfValue{U32.add(U32.add(left, right), 4)}}
    case PerfRequest_0_5{left, right}:
      PerfFinished{PerfValue{U32.is_lt(U32.add(left, 5), right)}}
    case PerfRequest_0_6{values, bias}:
      PerfFinished{PerfValue{Perf.shift(values, U32.add(bias, 6))}}
    case PerfRequest_0_7{payload, bias}:
      PerfFinished{PerfValue{Perf.payload_pair(payload, U32.add(bias, 7))}}
    case PerfRequest_0_8{left, right}:
      PerfFinished{PerfValue{U32.add(U32.add(left, right), 8)}}
    case PerfRequest_0_9{left, right}:
      PerfFinished{PerfValue{U32.is_lt(U32.add(left, 9), right)}}
    case PerfRequest_0_10{values, bias}:
      PerfFinished{PerfValue{Perf.shift(values, U32.add(bias, 10))}}
    case PerfRequest_0_11{payload, bias}:
      PerfFinished{PerfValue{Perf.payload_pair(payload, U32.add(bias, 11))}}
    case PerfRequest_0_12{left, right}:
      PerfFinished{PerfValue{U32.add(U32.add(left, right), 12)}}
    case PerfRequest_0_13{left, right}:
      PerfFinished{PerfValue{U32.is_lt(U32.add(left, 13), right)}}
    case PerfRequest_0_14{values, bias}:
      PerfFinished{PerfValue{Perf.shift(values, U32.add(bias, 14))}}
    case PerfRequest_0_15{payload, bias}:
      PerfFinished{PerfValue{Perf.payload_pair(payload, U32.add(bias, 15))}}

