    case PerfRequest_0_11{_, _}: Perf.Flagged()
    case PerfRequest_0_12{_, _}: U32
    case PerfRequest_0_13{_, _}: Bool
    case PerfRequest_0_14{_, _}: Perf.Words()
    case PerfRequest_0_15{_, _}: Perf.Flagged()

