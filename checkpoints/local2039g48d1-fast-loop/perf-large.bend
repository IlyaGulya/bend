      PerfFinished{PerfValue{U32.is_lt(U32.add(left, 53), right)}}
    case PerfRequest_3_6{values, bias}:
      PerfFinished{PerfValue{Perf.shift(values, U32.add(bias, 54))}}
    case PerfRequest_3_7{payload, bias}:
      PerfFinished{PerfValue{Perf.payload_pair(payload, U32.add(bias, 55))}}
    case PerfRequest_3_8{left, right}:
      PerfFinished{PerfValue{U32.add(U32.add(left, right), 56)}}
    case PerfRequest_3_9{left, right}:
      PerfFinished{PerfValue{U32.is_lt(U32.add(left, 57), right)}}
    case PerfRequest_3_10{values, bias}:
