  emitter_chunk(EmitResult, 64n, EmitterRunState{EmitResult, EmitterPending{EmitterRequestGroup_0{EmitterRequest_emit_c_library{program, exports, runtime, files}}, box => EmitterFinished{box}}, EmitterStackDone{{==}}})
