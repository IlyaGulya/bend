  "collectorSource": "def g73_collect_actual_rows_acc(cells, expected):\n    import math\n    pairs={}\n    for cell in cells:\n        report=json.loads(read(cell['report']))\n        request=json.loads(read(cell['command'][-2]))\n        assert report['status']=='PASS' and report['mode']=='js' and report['stopAfter']=='check'\n        assert report['requestSha256']==g56_ref_acc(cell['command'][-2])['sha256']\n        assert report['exports']==request['exports']==g73_c2_acc['exports']\n        assert report['moduleCount']==expected['modules'] and report['sourceDeclarations']==expected['declarations']\n        assert report['stepCounts']['expand']==expected['expand'] and report['stepCounts']['check']==expected['check']\n        assert report['checksExcluded']==0 and report['outputPatches']==0 and report.get('output') is None\n        assert len(request['inputs'])==expected['files']\n        assert report['workerPolicy']=={'stackMiB':256,'oldGenerationMiB':6144,'youngGenerationMiB':128}\n        assert report['runtime']['versions']['node']=='23.11.0' and report['runtime']['versions']['v8']=='12.9.202.28-node.14'\n        assert report['runtime']['execArgv']==['--experimental-strip-types','--max-old-space-size=6144','--max-semi-space-size=128']\n        assert Path(report['runtime']['execPath']).resolve()==Path(g43_tools_acc['node']).resolve()\n        assert report['limits']=={'memoryMiB':8192,'rssMiB':8192,'pollMs':10,'timeoutMs':600000}\n        guard=report['guardian']\n        assert guard['status']=='PASS' and guard['ownedTreeStopped']is True and guard['timeoutMs']==600000\n        assert guard['memoryLimitBytes']==8589934592 and guard['rssLimitBytes']==8589934592\n        assert all(Path(p).resolve().as_posix()==p and g56_ref_acc(p)['sha256']==h for p,h in request['pins'].items())\n        assert all(g56_ref_acc(p)['sha256']==h for p,h in request['inputs'].items())\n        image=g56_ref_acc(request['image'])\n        assert request['pins'][image['path']]==image['sha256']\n        phase=next(p for p in report['phases']if p['phase']=='check')\n        row={'id':cell['id'],'report':g56_ref_acc(cell['report']),'request':g56_ref_acc(cell['command'][-2]),'image':image,'checkerCpuMs':phase['userCpuMs']+phase['systemCpuMs'],'checkerWallMs':phase['elapsedMs'],'footprintBytes':guard['peakFootprintBytes'],'rssBytes':guard['peakRssBytes'],'modules':report['moduleCount'],'declarations':report['sourceDeclarations'],'steps':report['stepCounts'],'guardianElapsedMs':guard['elapsedMs']}\n        assert all(math.isfinite(row[m])and row[m]>0 for m in ['checkerCpuMs','checkerWallMs','footprintBytes','rssBytes'])\n        pairs.setdefault(cell['pair'],{})[cell['role']]=row\n    assert all(set(pair)=={'A','C'}for pair in pairs.values())\n    return [pairs[i]for i in sorted(pairs)]\n",
