    case CheckerRequestGroup_17{inner}: checker_result_group_17(inner)

type CheckerValue<-A: Type> is Type:
  CheckerValue{value: A}

type CheckerProgress<-A: Type> is Type:
  CheckerFinished{box: CheckerValue<A>}
  CheckerPending{request: CheckerRequest, resume: (@box: CheckerValue<checker_result(request)> -> CheckerProgress<A>)}
  CheckerDirect{-R: Type, -request: CheckerRequest, arguments: R, invoke: (@arguments: R -> CheckerProgress<checker_result(request)>), resume: (@box: CheckerValue<checker_result(request)> -> CheckerProgress<A>)}
  CheckerBound{-B: Type, inner: CheckerProgress<B>, resume: (@box: CheckerValue<B> -> CheckerProgress<A>)}


type CheckerStack<-A: Type, -R: Type> is Type:
  CheckerStackDone{equation: {A == R : Type}}
  CheckerStackMore{-B: Type, resume: (@box: CheckerValue<A> -> CheckerProgress<B>), rest: CheckerStack<B, R>}

type CheckerRun<-R: Type> is Type:
  CheckerRunFinished{box: CheckerValue<R>}
  CheckerRunState{-A: Type, progress: CheckerProgress<A>, stack: CheckerStack<A, R>}

def checker_cast_box(-A: Type, -R: Type, equation: {A == R : Type}, box: CheckerValue<A>) -> CheckerValue<R>:
  %equation : CheckerValue<_>
  box

def checker_unbox(-A: Type, box: CheckerValue<A>) -> A:
  match box:
    case CheckerValue{value}: value

def checker_pure_occurrence_term(v_0: IR.Occurrence) -> U32:
  match v_0:
    case IR.LocalReferenceOccurrence{_, _, _, v_9}:
      v_9
    case IR.TypedOccurrence{v_16, _, _, _, _, _}:
      v_16
    case IR.ScalarOccurrence{v_27, _, _, _, _}:
      v_27
    case IR.StringOccurrence{v_36, _, _, _}:
      v_36
    case IR.CaseOccurrence{v_44, _, _, _}:
      v_44
    case IR.LocalOccurrence{v_53, _, _, _, _}:
      v_53

def checker_pure_occurrence_type(v_0: IR.Occurrence) -> U32:
  match v_0:
    case IR.LocalReferenceOccurrence{_, v_7, _, _}:
      v_7
    case IR.TypedOccurrence{_, v_17, _, _, _, _}:
      v_17
    case IR.ScalarOccurrence{_, v_28, _, _, _}:
      v_28
    case IR.StringOccurrence{_, v_37, _, _}:
      v_37
    case IR.CaseOccurrence{_, v_45, _, _}:
      v_45
    case IR.LocalOccurrence{_, v_54, _, _, _}:
      v_54

def checker_pure_definition_explicit(v_0: IR.OptionalTerm, v_2: Bool) -> Bool:
  match v_0:
    case IR.SomeTerm{_}:
      v_2
    case IR.NoTerm{}:
      False{}

def checker_pure_checked_symbol_kind(v_0: Scope.GlobalKind) -> IR.SymbolKind:
  match v_0:
    case Scope.GlobalFamily{}:
      IR.FamilySymbol{}
    case Scope.GlobalConstructor{}:
      IR.ConstructorSymbol{}
    case Scope.GlobalDefinition{}:
      IR.DefinitionSymbol{}

def checker_pure_span_file(v_0: Ast.SourceSpan) -> String:
  match v_0:
    case Ast.SpanOf{+v_5, +v_6, +v_7}:
      v_9 = v_5
      v_9

def checker_match_5(v_1: Ast.Quantity) -> Bool:
  match v_1:
    case Ast.QZero{}:
      True{}
    case _:
      False{}

def checker_match_6(v_1: Ast.Quantity) -> Bool:
  match v_1:
    case Ast.QOne{}:
      True{}
    case _:
      False{}

def checker_match_7(v_1: Ast.Quantity) -> Bool:
  match v_1:
    case Ast.QMany{}:
      True{}
    case _:
      False{}

def checker_pure_same_quantity(v_0: Ast.Quantity, v_1: Ast.Quantity) -> Bool:
  match v_0:
    case Ast.QZero{}:
      checker_match_5(v_1)
    case Ast.QOne{}:
      checker_match_6(v_1)
    case Ast.QMany{}:
      checker_match_7(v_1)
