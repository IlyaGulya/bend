def checker_result(request: CheckerRequest) -> Type:
  match request:
    case CheckerRequestGroup_0{inner}: checker_result_group_0(inner)
    case CheckerRequestGroup_1{inner}: checker_result_group_1(inner)
    case CheckerRequestGroup_2{inner}: checker_result_group_2(inner)
    case CheckerRequestGroup_3{inner}: checker_result_group_3(inner)
    case CheckerRequestGroup_4{inner}: checker_result_group_4(inner)
    case CheckerRequestGroup_5{inner}: checker_result_group_5(inner)
    case CheckerRequestGroup_6{inner}: checker_result_group_6(inner)
    case CheckerRequestGroup_7{inner}: checker_result_group_7(inner)
    case CheckerRequestGroup_8{inner}: checker_result_group_8(inner)
    case CheckerRequestGroup_9{inner}: checker_result_group_9(inner)
    case CheckerRequestGroup_10{inner}: checker_result_group_10(inner)
    case CheckerRequestGroup_11{inner}: checker_result_group_11(inner)
    case CheckerRequestGroup_12{inner}: checker_result_group_12(inner)
    case CheckerRequestGroup_13{inner}: checker_result_group_13(inner)
    case CheckerRequestGroup_14{inner}: checker_result_group_14(inner)
    case CheckerRequestGroup_15{inner}: checker_result_group_15(inner)
    case CheckerRequestGroup_16{inner}: checker_result_group_16(inner)
    case CheckerRequestGroup_17{inner}: checker_result_group_17(inner)

type CheckerValue<-A: Type> is Type:
  CheckerValue{value: A}

type CheckerProgress<-A: Type> is Type:
  CheckerFinished{box: CheckerValue<A>}
  CheckerPending{request: CheckerRequest, resume: (@box: CheckerValue<checker_result(request)> -> CheckerProgress<A>)}
  CheckerDirect{-R: Type, -request: CheckerRequest, arguments: R, invoke: (@arguments: R -> CheckerProgress<checker_result(request)>), resume: (@box: CheckerValue<checker_result(request)> -> CheckerProgress<A>)}
  CheckerBound{-B: Type, inner: CheckerProgress<B>, resume: (@box: CheckerValue<B> -> CheckerProgress<A>)}


type CheckerStack<-A: Type, -R: Type> is Type:
  CheckerStackDone{equation: {A == R : Type}}
  CheckerStackMore{-B: Type, resume: (@box: CheckerValue<A> -> CheckerProgress<B>), rest: CheckerStack<B, R>}

type CheckerRun<-R: Type> is Type:
  CheckerRunFinished{box: CheckerValue<R>}
  CheckerRunState{-A: Type, progress: CheckerProgress<A>, stack: CheckerStack<A, R>}

def checker_cast_box(-A: Type, -R: Type, equation: {A == R : Type}, box: CheckerValue<A>) -> CheckerValue<R>:
  %equation : CheckerValue<_>
  box

def checker_unbox(-A: Type, box: CheckerValue<A>) -> A:
  match box:
    case CheckerValue{value}: value

def checker_pure_occurrence_term(v_0: IR.Occurrence) -> U32:
  match v_0:
    case IR.LocalReferenceOccurrence{_, _, _, v_9}:
      v_9
