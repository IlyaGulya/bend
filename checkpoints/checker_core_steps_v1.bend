def checker_result(request: CheckerRequest) -> Type:
  match request:
    case CheckerRequestGroup_0{inner}: checker_result_group_0(inner)
    case CheckerRequestGroup_1{inner}: checker_result_group_1(inner)
    case CheckerRequestGroup_2{inner}: checker_result_group_2(inner)
    case CheckerRequestGroup_3{inner}: checker_result_group_3(inner)
    case CheckerRequestGroup_4{inner}: checker_result_group_4(inner)
    case CheckerRequestGroup_5{inner}: checker_result_group_5(inner)
