def checker_step_one(request: CheckerRequest) -> CheckerProgress<checker_result(request)>:
  match request:
    case CheckerRequestGroup_0{inner}: checker_step_group_0(inner)
    case CheckerRequestGroup_1{inner}: checker_step_group_1(inner)
    case CheckerRequestGroup_2{inner}: checker_step_group_2(inner)
    case CheckerRequestGroup_3{inner}: checker_step_group_3(inner)
    case CheckerRequestGroup_4{inner}: checker_step_group_4(inner)
    case CheckerRequestGroup_5{inner}: checker_step_group_5(inner)
    case CheckerRequestGroup_6{inner}: checker_step_group_6(inner)
    case CheckerRequestGroup_7{inner}: checker_step_group_7(inner)
    case CheckerRequestGroup_8{inner}: checker_step_group_8(inner)
    case CheckerRequestGroup_9{inner}: checker_step_group_9(inner)
    case CheckerRequestGroup_10{inner}: checker_step_group_10(inner)
    case CheckerRequestGroup_11{inner}: checker_step_group_11(inner)
    case CheckerRequestGroup_12{inner}: checker_step_group_12(inner)
    case CheckerRequestGroup_13{inner}: checker_step_group_13(inner)
    case CheckerRequestGroup_14{inner}: checker_step_group_14(inner)
    case CheckerRequestGroup_15{inner}: checker_step_group_15(inner)
    case CheckerRequestGroup_16{inner}: checker_step_group_16(inner)
    case CheckerRequestGroup_17{inner}: checker_step_group_17(inner)

def checker_pop(-A: Type, -R: Type, stack: CheckerStack<A, R>, box: CheckerValue<A>) -> CheckerRun<R>:
  match stack:
    case CheckerStackDone{equation}: CheckerRunFinished{checker_cast_box(A, R, equation, box)}
    case CheckerStackMore{B, resume, rest}: CheckerRunState{B, resume(box), rest}

def checker_advance(-A: Type, -R: Type, progress: CheckerProgress<A>, stack: CheckerStack<A, R>) -> CheckerRun<R>:
  match progress:
    case CheckerFinished{box}: checker_pop(A, R, stack, box)
    case CheckerPending{request, resume}:
      CheckerRunState{checker_result(request), checker_step_one(request), CheckerStackMore{A, resume, stack}}
    case CheckerDirect{T, request, arguments, invoke, resume}:
      CheckerRunState{checker_result(request), invoke(arguments), CheckerStackMore{A, resume, stack}}
    case CheckerBound{B, inner, resume}:
      CheckerRunState{B, inner, CheckerStackMore{A, resume, stack}}

def checker_chunk(-R: Type, fuel: Nat, run: CheckerRun<R>) -> CheckerRun<R>:
  match fuel run:
    case 0n state: state
    case 1n+rest CheckerRunFinished{box}: CheckerRunFinished{box}
    case 1n+rest CheckerRunState{A, progress, stack}:
      checker_chunk(R, rest, checker_advance(A, R, progress, stack))

def checker_step(-R: Type, run: CheckerRun<R>) -> CheckerRun<R>:
  checker_chunk(R, 64n, run)

def checker_start(modules: List<&2, Loader.LoadedModule>) -> CheckerRun<Checked.CheckResult>:
  checker_chunk(Checked.CheckResult, 64n, CheckerRunState{Checked.CheckResult, CheckerPending{CheckerRequestGroup_16{CheckerRequest_check_modules{modules, Nil{}}}, box => CheckerFinished{box}}, CheckerStackDone{{==}}})

def checker_inspect_start(program: Checked.CheckedProgram) -> CheckerRun<Checked.Inspection>:
  checker_chunk(Checked.Inspection, 64n, CheckerRunState{Checked.Inspection, CheckerPending{CheckerRequestGroup_0{CheckerRequest_inspect_checked{program}}, box => CheckerFinished{box}}, CheckerStackDone{{==}}})
