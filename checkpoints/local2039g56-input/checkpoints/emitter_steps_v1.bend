def emitter_step_one(request: EmitterRequest) -> EmitterProgress<emitter_result(request)>:
  match request:
    case EmitterRequestGroup_0{inner}: emitter_step_group_0(inner)
    case EmitterRequestGroup_1{inner}: emitter_step_group_1(inner)
    case EmitterRequestGroup_2{inner}: emitter_step_group_2(inner)
    case EmitterRequestGroup_3{inner}: emitter_step_group_3(inner)
    case EmitterRequestGroup_4{inner}: emitter_step_group_4(inner)
    case EmitterRequestGroup_5{inner}: emitter_step_group_5(inner)
    case EmitterRequestGroup_6{inner}: emitter_step_group_6(inner)
    case EmitterRequestGroup_7{inner}: emitter_step_group_7(inner)
    case EmitterRequestGroup_8{inner}: emitter_step_group_8(inner)
    case EmitterRequestGroup_9{inner}: emitter_step_group_9(inner)
    case EmitterRequestGroup_10{inner}: emitter_step_group_10(inner)
    case EmitterRequestGroup_11{inner}: emitter_step_group_11(inner)
    case EmitterRequestGroup_12{inner}: emitter_step_group_12(inner)
    case EmitterRequestGroup_13{inner}: emitter_step_group_13(inner)
    case EmitterRequestGroup_14{inner}: emitter_step_group_14(inner)
    case EmitterRequestGroup_15{inner}: emitter_step_group_15(inner)
    case EmitterRequestGroup_16{inner}: emitter_step_group_16(inner)
    case EmitterRequestGroup_17{inner}: emitter_step_group_17(inner)
    case EmitterRequestGroup_18{inner}: emitter_step_group_18(inner)
    case EmitterRequestGroup_19{inner}: emitter_step_group_19(inner)
    case EmitterRequestGroup_20{inner}: emitter_step_group_20(inner)
    case EmitterRequestGroup_21{inner}: emitter_step_group_21(inner)
    case EmitterRequestGroup_22{inner}: emitter_step_group_22(inner)
    case EmitterRequestGroup_23{inner}: emitter_step_group_23(inner)
    case EmitterRequestGroup_24{inner}: emitter_step_group_24(inner)
    case EmitterRequestGroup_25{inner}: emitter_step_group_25(inner)
    case EmitterRequestGroup_26{inner}: emitter_step_group_26(inner)
    case EmitterRequestGroup_27{inner}: emitter_step_group_27(inner)
    case EmitterRequestGroup_28{inner}: emitter_step_group_28(inner)
    case EmitterRequestGroup_29{inner}: emitter_step_group_29(inner)
    case EmitterRequestGroup_30{inner}: emitter_step_group_30(inner)
    case EmitterRequestGroup_31{inner}: emitter_step_group_31(inner)
    case EmitterRequestGroup_32{inner}: emitter_step_group_32(inner)
    case EmitterRequestGroup_33{inner}: emitter_step_group_33(inner)

def emitter_pop(-A: Type, -R: Type, stack: EmitterStack<A, R>, box: EmitterValue<A>) -> EmitterRun<R>:
  match stack:
    case EmitterStackDone{equation}: EmitterRunFinished{emitter_cast_box(A, R, equation, box)}
    case EmitterStackMore{B, resume, rest}: EmitterRunState{B, resume(box), rest}

def emitter_advance(-A: Type, -R: Type, progress: EmitterProgress<A>, stack: EmitterStack<A, R>) -> EmitterRun<R>:
  match progress:
    case EmitterFinished{box}: emitter_pop(A, R, stack, box)
    case EmitterPending{request, resume}:
      EmitterRunState{emitter_result(request), emitter_step_one(request), EmitterStackMore{A, resume, stack}}
    case EmitterDirect{T, request, arguments, invoke, resume}:
      EmitterRunState{emitter_result(request), invoke(arguments), EmitterStackMore{A, resume, stack}}
    case EmitterBound{B, inner, resume}:
      EmitterRunState{B, inner, EmitterStackMore{A, resume, stack}}

def emitter_chunk(-R: Type, fuel: Nat, run: EmitterRun<R>) -> EmitterRun<R>:
  match fuel run:
    case 0n state: state
    case 1n+rest EmitterRunFinished{box}: EmitterRunFinished{box}
    case 1n+rest EmitterRunState{A, progress, stack}:
      emitter_chunk(R, rest, emitter_advance(A, R, progress, stack))

def emitter_step(-R: Type, run: EmitterRun<R>) -> EmitterRun<R>:
  emitter_chunk(R, 64n, run)

def emitter_start(program: Checked.CheckedProgram, files: List<&2, BIR.SourceFile>) -> EmitterRun<EmitResult>:
  emitter_chunk(EmitResult, 64n, EmitterRunState{EmitResult, EmitterPending{EmitterRequestGroup_0{EmitterRequest_emit{program, files}}, box => EmitterFinished{box}}, EmitterStackDone{{==}}})

def emitter_library_start(program: Checked.CheckedProgram, exports: List<&2, String>, files: List<&2, BIR.SourceFile>) -> EmitterRun<EmitResult>:
  emitter_chunk(EmitResult, 64n, EmitterRunState{EmitResult, EmitterPending{EmitterRequestGroup_0{EmitterRequest_emit_library{program, exports, files}}, box => EmitterFinished{box}}, EmitterStackDone{{==}}})

