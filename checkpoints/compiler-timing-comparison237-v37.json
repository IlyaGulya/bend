  "measurementProbeSource": "import * as Bend from '../checkpoints/.official-237-timing/bend2/bend.ts';\nimport * as Comp from '../checkpoints/.official-237-timing/bend2/comp.ts';\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {createHash} from 'node:crypto';\nimport {resolve} from 'node:path';\nimport {pathToFileURL} from 'node:url';\nimport {runCheckerSteps} from './checker_core_step_runtime.mjs';\nconst root=resolve('checkpoints/.bootstrap_compiler_root_v1.bend');\nconst artifact=resolve('checkpoints/.official-237-timing/root.mjs');\nconst report=resolve(process.argv[2]??'checkpoints/official-compiler-phases-release237-v37.json');\nconst hash=data=>createHash('sha256').update(data).digest('hex');\nconst started=performance.now(),cpuStarted=process.cpuUsage(),rows=[];\nconst emit=row=>console.log(JSON.stringify(row));\nconst state={diagnosticOnly:true,bootstrapAcceptance:false,release:'2.0.37',commit:'4ff8545f19b09b7d2b8ca2303668100eac8efd66',runtime:process.versions,root,rootSha256:hash(readFileSync(root)),compilerSources:['bend.ts','comp.ts','main.ts','safe.ts'].map(name=>({name,sha256:hash(readFileSync(resolve('checkpoints/.official-237-timing/bend2',name)))})),nativeHooks:false,checkedBodySpill:false,manualGC:false,mode:'Official book_load -> book_valid -> js_lib(book,true), same operations as CLI -o .mjs; whole module exports, not selected-nine export facade',rows};\nasync function phase(name,fn){\n const start=performance.now(),cpu=process.cpuUsage();let status='PASS';\n state.status='IN_PROGRESS';state.activePhase=name;writeFileSync(report,JSON.stringify(state,null,2)+'\\n');emit({event:'phase-start',phase:name,elapsedMs:start-started});\n try{return await fn();}catch(error){status='FAIL';throw error;}finally{\n  const used=process.cpuUsage(cpu),row={phase:name,status,wallMs:performance.now()-start,cpuMs:(used.user+used.system)/1000,memoryEnd:process.memoryUsage()};rows.push(row);emit({event:status==='PASS'?'phase-complete':'phase-failed',...row});writeFileSync(report,JSON.stringify(state,null,2)+'\\n');\n }\n}\ntry{\n const book=Bend.book_nil(),seen=new Map();\n await phase('load-parse-expand',()=>Bend.book_load(book,root,'',seen));\n state.loadedInputs=[...seen.keys()].map(file=>({file,sha256:hash(readFileSync(file))}));\n await phase('validate',()=>Bend.book_valid(book));\n if(book.hols!==0)throw Error('Incomplete official checked book: '+book.hols+' holes');\n state.events=book.order.length;state.checkedBodies=Object.values(book.tlds).filter(t=>t.$==='Def'&&t.e!==undefined).length;\n const source=await phase('prepare-and-emit-js',()=>Comp.js_lib(book,true));\n await phase('write-output',()=>writeFileSync(artifact,source));\n state.artifact={path:artifact,sha256:hash(source),bytes:Buffer.byteLength(source)};\n state.execution=await phase('execute-emitted-compiler',async()=>{\n  const library=(await import(pathToFileURL(artifact).href)).default;\n  const result=runCheckerSteps(library,{$:'Nil'}),short=x=>x?.$.split('.').at(-1);\n  if(short(result)!=='CheckSuccess'||short(result.modules)!=='Nil')throw Error('Official emitted compiler API smoke failed');\n  return{passed:true,result:'CheckSuccess',modules:'Nil',exportCount:Object.keys(library).length};\n });state.status='PASS';delete state.activePhase;\n}catch(error){state.status='FAIL';state.error=String(error);state.errorStack=error.stack;process.exitCode=1;}\nconst cpu=process.cpuUsage(cpuStarted);state.totalWallMs=performance.now()-started;state.totalCpuMs=(cpu.user+cpu.system)/1000;writeFileSync(report,JSON.stringify(state,null,2)+'\\n');emit({event:'result',...state,loadedInputs:state.loadedInputs?.length});\n",
